# Any OpenAI-compatible chat API can be used.
# Examples:
# - DeepSeek: OPENAI_BASE_URL=https://api.deepseek.com, CHAT_MODEL=deepseek-chat
# - OpenAI:   OPENAI_BASE_URL=https://api.openai.com/v1, CHAT_MODEL=gpt-4o-mini
OPENAI_API_KEY=your_api_key
OPENAI_BASE_URL=https://api.example.com
CHAT_MODEL=your-chat-model

# Keep local embeddings unless your provider offers an OpenAI-compatible embeddings endpoint.
EMBEDDING_MODEL=local

# Use your own trained YOLO model, for example:
# YOLO_MODEL=C:\path\to\your\best.pt
YOLO_MODEL=C:\path\to\your\best.pt
YOLO_CONFIDENCE=0.25

CHUNK_SIZE=900
CHUNK_OVERLAP=150
RETRIEVAL_TOP_K=5
MILVUS_COLLECTION=visual_multimodal_rag_chunks
